# pc2mb 服务端配置示例：复制为项目根目录 .env 并填入真实值（.env 已被 .gitignore 忽略）
# 生成哈希： python server/app.py --hash-password '你的密码'
# 生成随机 token/secret： python server/app.py --gen-secrets

PC2MB_USER=admin
PC2MB_PASSWORD_HASH=pbkdf2_sha256$200000$请替换为随机salt$请替换为哈希
PC2MB_AGENT_TOKEN=请替换为随机长字符串
PC2MB_COOKIE_SECRET=请替换为随机长字符串
PC2MB_HOST=127.0.0.1
PC2MB_PORT=18091
